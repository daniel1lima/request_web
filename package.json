{
  "name": "node_demo_project",
  "version": "1.0.0",
  "description": "The sample Node.js project with Next.js frontend",
  "type": "module",
  "scripts": {
    "start": "bun server/src/app.js",
    "server": "bun server/src/app.js",
    "client": "cd client && bun run dev",
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "build": "cd client && bun run build",
    "install:all": "bun install && cd client && bun install",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "all": "^0.0.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "debounce": "^2.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.17.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.1.6",
    "pg": "^8.11.3",
    "prettier": "^3.4.2",
    "react-icons": "^5.4.0",
    "sequelize": "^6.37.5",
    "stripe": "^17.6.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  }
}
